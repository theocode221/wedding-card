# Optional dedicated script for Naim dashboard (falls back to VITE_RSVP_GOOGLE_SCRIPT_URL)
# VITE_WHITE_GOLD_RSVP_GOOGLE_SCRIPT_URL=

# Farhan & Atheela (Paan) — Apps Script web app URL (optional; code has a default)
